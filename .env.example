# Copy to .env and fill in. Never commit the real file (.env is gitignored).

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development
ENABLE_DEV_SEED=true

# ---------------------------------------------------------------------------
# Ports (dev)
# ---------------------------------------------------------------------------
WEB_PORT=5173
API_PORT=3000
INDEXER_PORT=3100
AI_PORT=3200

# ---------------------------------------------------------------------------
# Databases — one per deployable, see WORKSPACE_AND_PACKAGE_STRATEGY.md.
# Locally these are four databases on one Postgres instance started by
# `pnpm infra:up` (postgres/create-databases.sql creates them and enables
# pgvector on aca_ai). In production each may live on its own instance.
# ---------------------------------------------------------------------------
API_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aca_api
INDEXER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aca_indexer
AI_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aca_ai
QUEUE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aca_queue

# ---------------------------------------------------------------------------
# Redis — cache, locks, OAuth state, SSE fan-out, rate limits
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, S3-compatible)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aca-snapshots
S3_ACCESS_KEY_ID=aca_minio_admin
S3_SECRET_ACCESS_KEY=aca_minio_admin_secret
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000

# ---------------------------------------------------------------------------
# Internal service token — separate from the user JWT keys, HS256, 60s TTL.
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
INTERNAL_JWT_SECRET=

# ---------------------------------------------------------------------------
# User-facing access-token JWT signing keys (RS256). Paste PEM contents with
# \n escapes. Generate per LOCAL_SETUP.md step 7:
#   openssl genpkey -algorithm RSA -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
# ---------------------------------------------------------------------------
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Envelope encryption key(s) for GitHub tokens at rest (AUTH_SERVICE_PLAN.md
# "Token Encryption"). Rotate by adding TOKEN_ENCRYPTION_KEY_V2 and bumping
# TOKEN_ENCRYPTION_ACTIVE_VERSION — never replace an existing key in place.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY_V1=
TOKEN_ENCRYPTION_KEY_V2=
TOKEN_ENCRYPTION_ACTIVE_VERSION=1
TOKEN_REFRESH_MARGIN_SECONDS=300

# ---------------------------------------------------------------------------
# GitHub App — see LOCAL_SETUP.md step 6. Not required to develop against
# the sample repository fixture.
# ---------------------------------------------------------------------------
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
GITHUB_API_BASE_URL=https://api.github.com

# Where the OAuth callback redirects the browser back to, and how long an
# OAuth `state`/PKCE pair stays valid in Redis before it's rejected.
PUBLIC_APP_URL=http://localhost:5173
OAUTH_STATE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# LLM provider (Stage 8/9)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
CHAT_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Every other tunable (repository size limits, graph node caps, retrieval
# and chat limits, rate limits, cost quotas) is documented with its default
# in SCOPE_LIMITS.md and is introduced as an env var by the module that
# consumes it, starting from the stage that module ships in — they are not
# needed to boot the Stage 1 skeleton and are intentionally not declared
# here yet.
# ---------------------------------------------------------------------------
